{
  "detection": {
    "launchBurst": {
      "windowHours": 24,
      "maxNormalLaunches": 10
    },
    "liquidityCollapse": {
      "maxLiquidityUsd": "5",
      "minHolders": 150,
      "minAthMcapUsd": "200000"
    },
    "automation": {
      "maxLiquiditySpreadUsd": "1.5",
      "minMatchingTokens": 3
    }
  },
  "rest": {
    "baseUrl": "https://api.solami.dev",
    "requestsPerSecond": 1,
    "burst": 1,
    "maxQueue": 500,
    "timeoutMs": 10000,
    "devHistoryTokenLimit": 200,
    "cache": {
      "identityMaxEntries": 100000,
      "securityTtlSeconds": 600,
      "securityMaxEntries": 20000,
      "devHistoryTtlSeconds": 60,
      "devHistoryMaxEntries": 20000
    },
    "liquidityHistory": {
      "maxMints": 50000,
      "maxReadingsPerMint": 120
    }
  },
  "stream": {
    "url": "wss://ws.solami.dev/data/subscribe",
    "chain": "solana",
    "types": ["token_create", "pool_create", "graduation", "liquidity", "transfer", "swap", "meme"],
    "backfill": 200,
    "dedupWindowPerType": 1000,
    "staleAfterMs": 30000,
    "reconnect": {
      "initialDelayMs": 1000,
      "maxDelayMs": 60000,
      "multiplier": 2,
      "resetAfterMs": 30000
    },
    "queue": {
      "capacity": 50000,
      "critical": ["token_create", "pool_create", "graduation"],
      "normal": ["liquidity", "meme", "metadata"]
    }
  },
  "persistence": {
    "enabled": true,
    "dir": "data/live",
    "maxFileMB": 50,
    "maxBufferMB": 16,
    "firehoseTypes": ["swap", "transfer"],
    "lifecycleMaxTotalMB": 1024,
    "firehoseMaxTotalMB": 500
  },
  "health": {
    "port": 8080,
    "logEveryMs": 30000
  }
}
